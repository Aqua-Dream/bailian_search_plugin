{
  "manifest_version": 2,
  "version": "5.1.2",
  "name": "百炼联网搜索插件",
  "description": "使用阿里云百炼 Responses API 提供联网搜索与文搜图；URL 直访本地抓取总结。",
  "author": {
    "name": "Aqua-Dream",
    "url": "https://github.com/Aqua-Dream"
  },
  "license": "AGPL",
  "urls": {
    "repository": "https://github.com/Aqua-Dream/bailian_search_plugin",
    "homepage": "https://github.com/Aqua-Dream/bailian_search_plugin",
    "documentation": "https://github.com/Aqua-Dream/bailian_search_plugin#readme",
    "issues": "https://github.com/Aqua-Dream/bailian_search_plugin/issues"
  },
  "host_application": {
    "min_version": "0.10.0",
    "max_version": "1.14.5"
  },
  "sdk": {
    "min_version": "2.3.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "openai",
      "version_spec": ">=1.95.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "beautifulsoup4",
      "version_spec": ">=4.11.0"
    },
    {
      "type": "python_package",
      "name": "lxml",
      "version_spec": ">=4.9.0"
    },
    {
      "type": "python_package",
      "name": "readability-lxml",
      "version_spec": ">=0.8.1"
    },
    {
      "type": "python_package",
      "name": "trafilatura",
      "version_spec": ">=1.6.0"
    },
    {
      "type": "python_package",
      "name": "charset-normalizer",
      "version_spec": ">=3.0.0"
    },
    {
      "type": "python_package",
      "name": "lxml-html-clean",
      "version_spec": ">=0.1.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp-socks",
      "version_spec": ">=0.8.0"
    },
    {
      "type": "python_package",
      "name": "brotli",
      "version_spec": ">=1.0.0"
    }
  ],
  "capabilities": [
    "llm.generate",
    "message.get_by_time_in_chat",
    "config.get",
    "send.text",
    "send.image",
    "send.forward"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "aqua-dream.bailian-search-plugin"
}
